# Python-generated files
__pycache__/
*.py[oc]
*.pyo
build/
dist/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.cache/
.coverage
htmlcov/

# uv
.uv/

# macOS
.DS_Store

# Secrets
.env

# Runtime data (screenshots and parsed/formatted JSON caches)
captures/
parsed/
formatted/

# Benchmark artifacts (generated locally from saved captures; model/machine-specific)
tests/benchmark/baselines/
tests/benchmark/results/

# Keep fixtures and docs screenshots, ignore any accidental PNGs elsewhere
*.png
!fixtures/**/*.png
!docs/screenshots/*.png
